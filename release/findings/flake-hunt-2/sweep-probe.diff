+/// PROBE (not for commit): with `PROBE_SWEEP=1`, the dead names in a
+/// listing waited out until the segment work's idle sweep has unlinked
+/// them, which puts the sweep between the listing and the reads.
+#[cfg(target_os = "linux")]
+fn probe_swept(listed: &[PathBuf]) {
+    if std::env::var_os("PROBE_SWEEP").is_none() {
+        return;
+    }
+    let dead: Vec<&PathBuf> = listed
+        .iter()
+        .filter(|f| f.to_string_lossy().contains("zpg-dead-"))
+        .collect();
+    eprintln!("PROBE listed {} of which dead {}: {dead:?}", listed.len(), dead.len());
+    let names = |d: &Path| common::store_names(d);
+    for f in &dead {
+        let dir = f.parent().unwrap();
+        let name = f.file_name().unwrap().to_string_lossy().into_owned();
+        let t = std::time::Instant::now();
+        while names(dir).contains(&name) && t.elapsed().as_secs() < 30 {
+            std::thread::sleep(std::time::Duration::from_millis(5));
+        }
+        eprintln!("PROBE {name} swept: {}", !names(dir).contains(&name));
+    }
+}
