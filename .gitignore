/target

# Profiler output. A bare `valgrind --tool=cachegrind` drops one of these in
# the cwd, and one of them reached the repository root and stayed there.
cachegrind.out.*
callgrind.out.*
perf.data*

# Build artifacts of the browser reader: `web/build.sh` writes the module, and
# the floor it is measured against is its own crate with its own target dir.
/web/supdb.wasm
/web/floor/target

# Subagent worktrees: separate checkouts, never part of this tree
.claude/worktrees/
