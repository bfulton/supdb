+/// A retired file under its dead name (`Options::retired_reaped`), and
+/// the segment it was retired with: until nothing holds that segment, a
+/// state a reader pins or a job, its mappings of the file stand.
+struct Dead {
+    path: PathBuf,
+    holder: std::sync::Weak<Seg>,
+    bytes: u64,
+    /// A file whose pages are clean, a segment synced before it landed,
+    /// and whose memory is given back as the segment is let go
+    /// (`vault::let_go`); an ordered index is written unsynced and a form
+    /// file may be, and their pages go at the free.
+    clean: bool,
+}
+
+/// The dead name of a retired file the reaper frees: a name no open takes
+/// for a segment, an index or a form file, so a crash between the rename
+/// and the free leaves one the next open sweeps (`sweep_dead`).
+fn dead_name(n: u64) -> String {
+    format!("dead-{n:08}")
+}
+
+/// Whether `name` is a dead name (`dead_name`).
+fn is_dead_name(name: &str) -> bool {
+    name.starts_with("dead-")
+}
+
+/// The dead names a store closed or crashed before freeing, removed: at
+/// the open, with the spares beside them.
+fn sweep_dead(dir: &Path) -> Result<()> {
+    for name in vault::names(dir)? {
+        if is_dead_name(&name) {
+            let _ = vault::remove_file(dir.join(name));
+        }
+    }
+    Ok(())
+}
+
+/// Dead files' bytes waiting past which the reaper frees at the device's
+/// usual class and not its idle one: a burst can retire inputs faster than
+/// an idle class is served beside its merges, and what waits is the disk's.
+const REAP_IDLE_BYTES: u64 = 1 << 30;
+
+/// The queue between the segment work and its reaper (`Options::retired_
+/// reaped`): the dead files let go, in order, the bytes buried and not yet
+/// freed, and the turn the reaper holds across each free, which a pause of
+/// the segment work takes for its length -- a test's copy of a live store,
+/// a crash -- so that no file goes from under either.
+#[derive(Default)]
+struct Reap {
+    files: std::sync::Mutex<std::collections::VecDeque<(PathBuf, u64)>>,
+    ready: std::sync::Condvar,
+    stop: std::sync::atomic::AtomicBool,
+    turn: std::sync::Mutex<()>,
+    /// Dead files' bytes buried and not yet freed, and the most there
+    /// have been at once.
+    waiting: AtomicU64,
+    waiting_peak: AtomicU64,
+    /// Files buried, handed to the reaper and freed, for the counts.
+    buried: AtomicU64,
+    handed: AtomicU64,
+    freed: AtomicU64,
+    /// A test's hold on the reaper ahead of each free (`Db::hold_reaper`).
+    held: std::sync::atomic::AtomicBool,
+}
+
+impl Reap {
+    fn take(&self) -> Option<(PathBuf, u64)> {
+        let mut q = self.files.lock().unwrap_or_else(|e| e.into_inner());
+        loop {
+            if let Some(f) = q.pop_front() {
+                return Some(f);
+            }
+            if self.stop.load(AtomicOrdering::Acquire) {
+                return None;
+            }
+            q = self.ready.wait(q).unwrap_or_else(|e| e.into_inner());
+        }
+    }
+
+    /// One file freed: its name unlinked with its bytes held, and the
+    /// bytes let go, which is the discard of its blocks.
+    fn free(&self, path: &Path, bytes: u64, idle: bool) {
+        while self.held.load(AtomicOrdering::Acquire) {
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        let _turn = self.turn.lock().unwrap_or_else(|e| e.into_inner());
+        let held = vault::unlink_held(path).unwrap_or_default();
+        if idle && self.waiting.load(AtomicOrdering::Relaxed) <= REAP_IDLE_BYTES {
+            with_idle_io(|| drop(held));
+        } else {
+            drop(held);
+        }
+        self.waiting.fetch_sub(bytes, AtomicOrdering::Relaxed);
+        self.freed.fetch_add(1, AtomicOrdering::Relaxed);
+    }
+}
+
+/// The reaper's thread: every dead file handed to it freed in turn, at
+/// the lowest of the usual CPU priorities, until the segment work stops.
+fn reap_thread(shared: std::sync::Arc<Shared>, idle: bool) {
+    lowest_nice();
+    while let Some((path, bytes)) = shared.reap.take() {
+        shared.reap.free(&path, bytes, idle);
+    }
+}
+
+/// The calling thread at the lowest nice level, which the scheduler still
+/// gives a share of a core: a thread in the idle class may wait for one
+/// for as long as the cores are busy, and what it frees waits with it.
+/// Linux only; elsewhere a no-op, a failure ignored as `idle_io_priority`
+/// ignores its.
+fn lowest_nice() {
+    #[cfg(target_os = "linux")]
+    // SAFETY: two calls on this thread's own priority, with no pointer.
+    unsafe {
+        let _ = libc::setpriority(libc::PRIO_PROCESS, libc::gettid() as libc::id_t, 19);
+    }
+}
