+/// The store the reaper's tests share (`Options::retired_reaped`): small
+/// seals and partitions, so that a few rounds of rewrites merge, promote and
+/// retire, with its rounds written by `reap_round`.
+fn reap_store(d: &std::path::Path) -> Db {
+    Db::create(
+        d,
+        Options {
+            seal_bytes: 64 << 10,
+            partition_bytes: Some(128 << 10),
+            retired_reaped: true,
+            ..Default::default()
+        },
+    )
+    .unwrap()
+}
+
+/// Every key of the reaper's stores given one more value, committed and
+/// flushed.
+fn reap_round(db: &mut Db, round: u32) {
+    for k in 0u32..2_000 {
+        let key = format!("key-{k:06}").into_bytes();
+        db.append(
+            &key,
+            format!("value-{round}-{k}-{}", "z".repeat(40)).as_bytes(),
+        );
+    }
+    db.commit().unwrap();
+    db.flush().unwrap();
+}
+
+/// The dead names in a plain store's directory (`Options::retired_reaped`).
+fn dead_names(d: &std::path::Path) -> usize {
+    std::fs::read_dir(d)
+        .unwrap()
+        .flatten()
+        .filter(|e| e.file_name().to_string_lossy().starts_with("dead-"))
+        .count()
+}
+
+/// Waits until the reaper has freed every file buried, sweeping the states
+/// the writer replaced at each look, as its operations do.
+fn reaped(db: &Db, d: &std::path::Path) {
+    let t0 = std::time::Instant::now();
+    loop {
+        let _ = read_vec(db, b"key-000000");
+        let w = db.seal_waits();
+        if w.retired_freed == w.retired_buried && dead_names(d) == 0 {
+            return;
+        }
+        assert!(
+            t0.elapsed() < std::time::Duration::from_secs(60),
+            "the reaper left {} of {} files buried after a minute, {} dead names standing",
+            w.retired_buried - w.retired_freed,
+            w.retired_buried,
+            dead_names(d)
+        );
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+}
+
+/// A retired segment a reader still holds stands under its dead name, read
+/// as it was, and the reaper frees it once nothing holds it: a snapshot
+/// taken before the rewrites reads every key as it read them through the
+/// merges that retire what it holds, and released, every file buried is
+/// freed and no dead name is left.
+#[test]
+fn a_retired_segment_is_freed_by_the_reaper_once_nothing_holds_it() {
+    let d = dir("reap-held");
+    let mut db = reap_store(&d);
+    for round in 0..3 {
+        reap_round(&mut db, round);
+    }
+    db.settle().unwrap();
+    let h = db.reader().unwrap();
+    h.snapshot();
+    let keys: Vec<Vec<u8>> = (0u32..2_000)
+        .map(|k| format!("key-{k:06}").into_bytes())
+        .collect();
+    let before: Vec<Vec<Vec<u8>>> = keys.iter().map(|k| read_vec(&h, k)).collect();
+    for round in 3..9 {
+        reap_round(&mut db, round);
+    }
+    db.settle().unwrap();
+    let w = db.seal_waits();
+    assert!(
+        w.retired_buried > 0,
+        "nothing was retired, so this proves nothing"
+    );
+    assert!(
+        dead_names(&d) > 0,
+        "the segments the snapshot holds were not kept under dead names"
+    );
+    // What the snapshot holds is never handed, however long it is held:
+    // read over a span the segment work has many turns in.
+    let t0 = std::time::Instant::now();
+    while t0.elapsed() < std::time::Duration::from_millis(300) {
+        let _ = read_vec(&db, b"key-000000");
+        let w = db.seal_waits();
+        assert!(
+            w.retired_handed < w.retired_buried,
+            "every file buried was handed to the reaper with a snapshot holding its segment"
+        );
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    for (k, b) in keys.iter().zip(&before) {
+        assert_eq!(&read_vec(&h, k), b, "the snapshot reads {k:?} as it did");
+    }
+    h.release();
+    drop(h);
+    reaped(&db, &d);
+    let w = db.seal_waits();
+    assert_eq!(w.retired_handed, w.retired_buried);
+    assert_eq!(w.retired_waiting_bytes, 0, "the bytes counted waiting");
+    for (i, k) in keys.iter().enumerate() {
+        let vals = read_vec(&db, k);
+        assert_eq!(vals.len(), 9, "{k:?} has its nine values");
+        assert_eq!(
+            vals[8],
+            format!("value-8-{i}-{}", "z".repeat(40)).into_bytes()
+        );
+    }
+    drop(db);
+    let db = Db::open(&d, Options::default()).unwrap();
+    for k in &keys {
+        assert_eq!(read_vec(&db, k).len(), 9, "{k:?} after a reopen");
+    }
+}
+
+/// The dead names a store crashed with are the next open's to sweep: a
+/// snapshot holds the merges' inputs under their dead names when the store
+/// dies, and the open after it removes every one and reads every key.
+#[test]
+fn a_dead_name_a_crash_left_is_swept_at_the_open() {
+    let d = dir("reap-crash");
+    let mut db = reap_store(&d);
+    for round in 0..3 {
+        reap_round(&mut db, round);
+    }
+    db.settle().unwrap();
+    let h = db.reader().unwrap();
+    h.snapshot();
+    for round in 3..9 {
+        reap_round(&mut db, round);
+    }
+    db.settle().unwrap();
+    assert!(dead_names(&d) > 0, "no dead name stood at the crash");
+    std::mem::forget(h);
+    db.crash();
+    let db = Db::open(&d, Options::default()).unwrap();
+    assert_eq!(dead_names(&d), 0, "a dead name outlived the open");
+    for k in 0u32..2_000 {
+        let key = format!("key-{k:06}").into_bytes();
+        assert_eq!(read_vec(&db, &key).len(), 9, "{key:?} after the crash");
+    }
+}
+
+/// A store's close frees what its reaper was handed and had not freed, and
+/// the files nothing had let go yet: none is left under a dead name, with
+/// the reaper held ahead of every free until the close.
+#[test]
+fn a_close_frees_every_dead_file() {
+    let d = dir("reap-close");
+    let mut db = reap_store(&d);
+    db.hold_reaper(true);
+    for round in 0..9 {
+        reap_round(&mut db, round);
+    }
+    db.settle().unwrap();
+    let t0 = std::time::Instant::now();
+    while db.seal_waits().retired_handed == 0 {
+        let _ = read_vec(&db, b"key-000000");
+        assert!(
+            t0.elapsed() < std::time::Duration::from_secs(60),
+            "nothing was handed to the reaper"
+        );
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    assert!(dead_names(&d) > 0, "no dead name stood at the close");
+    assert_eq!(db.seal_waits().retired_freed, 0);
+    drop(db);
+    assert_eq!(dead_names(&d), 0, "a dead name outlived the close");
+    let db = Db::open(&d, Options::default()).unwrap();
+    for k in 0u32..2_000 {
+        let key = format!("key-{k:06}").into_bytes();
+        assert_eq!(read_vec(&db, &key).len(), 9, "{key:?} after the close");
+    }
+}
+
+/// A pause of the segment work holds the reaper too: files handed to it
+/// and not yet freed when the segment work is paused -- for a test's copy
+/// of a live store, or a crash -- stand until the pause ends, where a free
+/// beside the copy would take a file from under it.
+#[test]
+fn a_pause_of_the_segment_work_holds_the_reaper() {
+    let d = dir("reap-pause");
+    let mut db = reap_store(&d);
+    db.hold_reaper(true);
+    for round in 0..9 {
+        reap_round(&mut db, round);
+    }
+    db.settle().unwrap();
+    // The writer's reads sweep the states the merges replaced; the segment
+    // work hands their files to the reaper, held ahead of each free.
+    let t0 = std::time::Instant::now();
+    while db.seal_waits().retired_handed == 0 {
+        let _ = read_vec(&db, b"key-000000");
+        assert!(
+            t0.elapsed() < std::time::Duration::from_secs(60),
+            "nothing was handed to the reaper"
+        );
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    let pause = db.pause_segment_work().expect("the segment work's thread");
+    let standing = dead_names(&d);
+    assert!(standing > 0, "the files handed stand under their names");
+    db.hold_reaper(false);
+    std::thread::sleep(std::time::Duration::from_millis(300));
+    assert_eq!(
+        dead_names(&d),
+        standing,
+        "the reaper freed a file while the segment work was paused"
+    );
+    assert_eq!(db.seal_waits().retired_freed, 0);
+    drop(pause);
+    reaped(&db, &d);
+}
