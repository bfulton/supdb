+    assert!(after.iter().all(|vals| vals.len() == 6), "six values a key");
+    drop(db);
+    let db = Db::open(&d, opts()).unwrap();
+    assert_eq!(all_values(&db, n), after, "the store after a reopen");
+    assert_eq!(
+        db.cipher_counts().unwrap().swept,
+        0,
+        "an envelope nobody named was left for the open"
+    );
+}
