+    if grep -q 'landed' "$X/src/db.rs" && ! grep -q 'let keep_snap = (same_frozen)\|let keep_snap = same_frozen;' "$X/src/db.rs"; then
+      echo "no keep_snap line to take the landing out of" >&2; exit 2
