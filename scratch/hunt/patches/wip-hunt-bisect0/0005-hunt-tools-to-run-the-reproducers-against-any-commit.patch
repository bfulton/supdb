--- /dev/null
+++ b/scripts/hunt_bisect0/diagport.pl
@@ -0,0 +1,43 @@
+#!/usr/bin/perl
+# usage: perl diagport.pl SRC/DB.RS
+# The stale-cut diagnostic, ported to a commit that has Reader::rebase_tables (e607e70 and after): at each rebase
+# of a rewritten partition (HUNT_CHECK_CUTS=1) it counts the filed keys the table carries and how many of them have
+# a cut that is not the new partition's. Nothing else of the engine changes.
+use strict;
+use warnings;
+my $path = shift or die "usage: diagport.pl db.rs\n";
+local $/;
+open(my $in, '<', $path) or die "open $path: $!";
+my $src = <$in>;
+close($in);
+my $n = ($src =~ s{
+    (^[ \t]*t\.pieces\ =\ pieces;\n
+     [ \t]*t\.piece_ranks\ =\ piece_ranks;\n
+     ([ \t]*)if\ rebased\ \{\n)
+}{$1$2    if keep_snap && std::env::var("HUNT_CHECK_CUTS").is_ok() {
+$2        let mut stale = 0usize;
+$2        let mut total = 0usize;
+$2        for (b, list) in t.added.iter().enumerate() {
+$2            for &(slot, cut) in list {
+$2                if slot as usize >= self.mem().len() {
+$2                    continue;
+$2                }
+$2                total += 1;
+$2                let key = self.mem().key_of(self.mem().entry(slot as usize));
+$2                let (nb, ncut) = BuildCtx::owner_of(seg, key);
+$2                if nb != b || ncut != cut {
+$2                    stale += 1;
+$2                }
+$2            }
+$2        }
+$2        eprintln!(
+$2            "HUNTCUTS rebase p {p}: {} filed keys carried, {} with a cut that is not the new partition's (keep_snap {keep_snap})",
+$2            total, stale
+$2        );
+$2    }
+}mx);
+die "the rebase site was not found exactly once in $path ($n)\n" unless $n == 1;
+open(my $out, '>', $path) or die "write $path: $!";
+print $out $src;
+close($out);
+print "diag ported to $path\n";
diff --git a/scripts/hunt_bisect0/hookport.pl b/scripts/hunt_bisect0/hookport.pl
new file mode 100644
index 0000000..2d6fc84
--- /dev/null
+++ b/scripts/hunt_bisect0/hookport.pl
@@ -0,0 +1,32 @@
+#!/usr/bin/perl
+# usage: perl hookport.pl SRC/DB.RS
+# The forcing hook of the snapshot schedule, ported to any commit that has the block cache's published forms:
+# a Snapshot handle's scan pauses for HUNT_SCAN_AFTER_CHECK_MS between its one check of the published
+# forms' position and its first load of a form. Nothing else of the engine changes.
+use strict;
+use warnings;
+my $path = shift or die "usage: hookport.pl db.rs\n";
+local $/;
+open(my $in, '<', $path) or die "open $path: $!";
+my $src = <$in>;
+close($in);
+my $n = ($src =~ s{
+    ^([ \t]*)(let\ canon:\ Option<&Cached>\ =\n
+    [ \t]*match\ canonical\.then\(\|\|\ self\.canonical\(pi,\ b\)\)\.flatten\(\)\ \{)
+}{$1if canonical && self.isolation.get() == Isolation::Snapshot {\n$1    hunt_pause("HUNT_SCAN_AFTER_CHECK_MS");\n$1}\n$1$2}mx);
+die "the load site was not found in $path\n" unless $n == 1;
+$src .= <<'RS';
+
+/// HUNT: a pause of the number of milliseconds the variable names, to hold
+/// a thread at a point of a forcing schedule (a hunt branch's patch, never
+/// for a merge).
+fn hunt_pause(var: &str) {
+    if let Some(ms) = std::env::var(var).ok().and_then(|s| s.parse::<u64>().ok()) {
+        std::thread::sleep(std::time::Duration::from_millis(ms));
+    }
+}
+RS
+open(my $out, '>', $path) or die "write $path: $!";
+print $out $src;
+close($out);
+print "hooked $path ($n site)\n";
