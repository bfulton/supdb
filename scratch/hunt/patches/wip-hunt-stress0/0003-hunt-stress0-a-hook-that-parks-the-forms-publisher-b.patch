+                    return Err(format!(
+                        "HUNT-FAIL windows-writer from {} for {cap}: {line}\nkey {}",
+                        show(start),
+                        show(&key)
+                    ));
+                }
+            }
+            let got = scanned(w.latest.as_ref().unwrap(), start, cap);
+            if cfg.strict {
+                if let Some((key, line)) = parting(&got, &want) {
+                    return Err(format!(
+                        "HUNT-FAIL windows-latest from {} for {cap}: {line}\nkey {}",
+                        show(start),
+                        show(&key)
+                    ));
