diff --git a/tests/hunt_stress0/run_one.sh b/tests/hunt_stress0/run_one.sh
index 64a94bc..0b23c24 100755
--- a/tests/hunt_stress0/run_one.sh
+++ b/tests/hunt_stress0/run_one.sh
@@ -13,6 +13,12 @@ RC=$?
 rm -rf "$T"
 LOG="$OUT/log/$ID.txt"
 if [ "$RC" = 0 ] && grep -q 'HUNT-OK' "$LOG"; then
+  if grep -q 'HUNT-PROVENANCE' "$LOG"; then
+    # A build met a cut that was not what its partition says, and nothing
+    # asserted and no answer was wrong: kept for reading.
+    echo "ok-stale-cut $ID"
+    exit 0
+  fi
   echo "ok $ID"
   rm -f "$LOG"
   exit 0
