+    /// HUNT: who an event is of: the upkeep thread's understudy, a handle's
+    /// slot, or the writer's own handle.
+    fn who(&self) -> u32 {
+        if self.understudy {
+            254
+        } else {
+            self.slot.map_or(255, |s| s as u32)
+        }
+    }
