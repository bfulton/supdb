+// ---------------------------------------------------------------------
+// run-dir: a direct run's temp file is the run's log and the name the
+// open finds it by, and no manifest names it, so the name is made durable
+// -- a directory fsync while it is in the directory -- before the first
+// commit into it is acknowledged: the run's first commit its policy makes
+// due, a `sync` over the open run, or the sync that writes a batch the
+// run's file owes again. Once a run; under a cipher a run's file is a
+// memory file and its commits frames of the log, and no barrier is made.
+// ---------------------------------------------------------------------
+
+/// The open run's temp names in `d`.
+fn rd_tmps(d: &Path) -> Vec<String> {
+    let mut v: Vec<String> = std::fs::read_dir(d)
+        .unwrap()
+        .filter_map(|e| e.ok())
+        .map(|e| e.file_name().to_string_lossy().into_owned())
+        .filter(|n| n.starts_with("direct-") && n.ends_with(".tmp"))
+        .collect();
+    v.sort();
+    v
+}
