+/// Whether an fsync of the store's directory has been made while `name`
+/// was in it, by the calls themselves (`Db::watch_dir_syncs`).
+fn rd_covered(db: &Db, name: &str) -> bool {
+    db.dir_syncs_watched()
+        .iter()
+        .any(|(_, names)| names.iter().any(|n| n == name))
+}
+
+/// How many run barriers the watch has seen.
+fn rd_barriers(db: &Db) -> usize {
+    db.dir_syncs_watched().iter().filter(|(run, _)| *run).count()
+}
+
+/// `n` keys above the store's greatest from `from`, committed: what opens
+/// a run where none is open, and an ordered load's commit otherwise.
+fn rd_batch(db: &mut Db, from: u32, n: u32) -> std::io::Result<()> {
+    for k in from..from + n {
+        db.append(key(k).as_bytes(), b"v");
+    }
+    db.commit()
+}
+
+/// Under `Always` every commit of a run is acknowledged by an fdatasync of
+/// its temp file, and the open finds the run by that name alone, so the
+/// first commit returns behind a directory fsync made while the name was
+/// in the directory; once a run, for the store's first run and for the
+/// run after a flush closed it, each a name of its own.
+#[test]
+fn a_runs_first_acknowledged_commit_follows_a_directory_fsync_that_names_its_file() {
+    let d = dir("dur-rd-always");
+    let mut db = Db::create(&d, Options::default()).unwrap();
+    db.watch_dir_syncs();
+    rd_batch(&mut db, 0, 100).unwrap();
+    let first = rd_tmps(&d);
+    assert_eq!(first.len(), 1, "the batch opened a run: {first:?}");
+    let first_covered = rd_covered(&db, &first[0]);
+    for c in 1..20 {
+        rd_batch(&mut db, c * 100, 100).unwrap();
+    }
+    let once = rd_barriers(&db);
+    reads(&db, &key(42), "v", "the run's first batch");
+
+    // The control: the watch records, and the landing's directory fsync
+    // after the close's link lists the closed run's segment.
+    db.flush().unwrap();
+    db.settle().unwrap();
+    assert!(
+        db.dir_syncs_watched()
+            .iter()
+            .any(|(_, names)| names.iter().any(|n| n.ends_with(".sup"))),
+        "the landing's directory fsync was watched with the segment's name"
+    );
+    assert!(
+        first_covered,
+        "the run's first commit was acknowledged with no directory fsync \
+         since {} was created",
+        first[0]
+    );
+    assert_eq!(once, 1, "one barrier for the run's twenty commits");
+
+    let before = rd_barriers(&db);
+    rd_batch(&mut db, 100_000, 100).unwrap();
+    let second: Vec<String> = rd_tmps(&d)
+        .into_iter()
+        .filter(|n| !first.contains(n))
+        .collect();
+    assert_eq!(second.len(), 1, "the batch opened a new run: {second:?}");
+    assert!(
+        rd_covered(&db, &second[0]),
+        "the second run's first commit was acknowledged with no directory \
+         fsync since {} was created",
+        second[0]
+    );
+    assert_eq!(rd_barriers(&db), before + 1, "the second run's one barrier");
+    drop(db);
+    let _ = std::fs::remove_dir_all(&d);
+}
+
+/// Under `EveryN(2)` a run's commits are acknowledged by the sync its
+/// second commit makes, and that sync's answer comes behind the barrier.
+#[test]
+fn a_runs_first_sync_by_policy_follows_a_directory_fsync_that_names_its_file() {
+    let d = dir("dur-rd-everyn");
+    let o = Options {
+        sync: SyncPolicy::EveryN(2),
+        ..Options::default()
+    };
+    let mut db = Db::create(&d, o).unwrap();
+    db.watch_dir_syncs();
+    rd_batch(&mut db, 0, 100).unwrap();
+    let tmps = rd_tmps(&d);
+    assert_eq!(tmps.len(), 1, "the batch opened a run: {tmps:?}");
+    rd_batch(&mut db, 100, 100).unwrap();
+    assert_eq!(rd_tmps(&d), tmps, "the same run");
+    assert!(
+        rd_covered(&db, &tmps[0]),
+        "the run's commits were acknowledged by a sync with no directory \
+         fsync since {} was created",
+        tmps[0]
+    );
+    for c in 2..12 {
+        rd_batch(&mut db, c * 100, 100).unwrap();
+    }
+    assert_eq!(rd_barriers(&db), 1, "one barrier for the run's syncs");
+    drop(db);
+    let _ = std::fs::remove_dir_all(&d);
+}
+
+/// Under a policy that never syncs at a commit, `Db::sync` is the run's
+/// acknowledgement, and the run's name is part of what it makes durable.
+#[test]
+fn a_sync_over_an_open_run_follows_a_directory_fsync_that_names_its_file() {
+    let d = dir("dur-rd-sync");
+    let o = Options {
+        sync: SyncPolicy::EveryN(u32::MAX),
+        ..Options::default()
+    };
+    let mut db = Db::create(&d, o).unwrap();
+    db.watch_dir_syncs();
+    rd_batch(&mut db, 0, 100).unwrap();
+    let tmps = rd_tmps(&d);
+    assert_eq!(tmps.len(), 1, "the batch opened a run: {tmps:?}");
+    db.sync().unwrap();
+    assert!(
+        rd_covered(&db, &tmps[0]),
+        "sync() returned with no directory fsync since {} was created",
+        tmps[0]
+    );
+    for c in 1..5 {
+        rd_batch(&mut db, c * 100, 100).unwrap();
+        db.sync().unwrap();
+    }
+    assert_eq!(rd_tmps(&d), tmps, "the same run");
+    assert_eq!(rd_barriers(&db), 1, "one barrier for the run's syncs");
+    drop(db);
+    let _ = std::fs::remove_dir_all(&d);
+}
+
+/// A run's first batch whose write failed is owed by its file, and the
+/// call with nothing new that writes and syncs it again -- a commit of
+/// nothing, a `sync` -- is its first acknowledgement, behind the barrier.
+#[test]
+fn the_sync_of_a_runs_owed_first_batch_follows_a_directory_fsync_that_names_its_file() {
+    for again in ["commit", "sync"] {
+        let d = dir(&format!("dur-rd-again-{again}"));
+        let mut db = Db::create(&d, Options::default()).unwrap();
+        db.watch_dir_syncs();
+        db.fail_next_run_write();
+        injected(rd_batch(&mut db, 0, 100), &format!("{again}: the first batch"));
+        let tmps = rd_tmps(&d);
+        assert_eq!(tmps.len(), 1, "{again}: the batch opened a run: {tmps:?}");
+        match again {
+            "commit" => db.commit(),
+            _ => db.sync(),
+        }
+        .unwrap_or_else(|e| panic!("{again}: the owed batch written again: {e}"));
+        assert!(
+            rd_covered(&db, &tmps[0]),
+            "{again}: the owed batch was acknowledged with no directory fsync \
+             since {} was created",
+            tmps[0]
+        );
+        drop(db);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
+
+/// A barrier that fails is the acknowledgement's answer, and kept: the
+/// commit or `sync` it was for answers the error, and every commit and
+/// `sync` after it, until the store is reopened (`Db::lost`).
+#[test]
+fn a_failed_barrier_of_a_runs_file_is_answered_and_kept() {
+    for (tag, policy) in [
+        ("always", SyncPolicy::Always),
+        ("everyn", SyncPolicy::EveryN(2)),
+        ("sync", SyncPolicy::EveryN(u32::MAX)),
+    ] {
+        let d = dir(&format!("dur-rd-fail-{tag}"));
+        let o = Options {
+            sync: policy,
+            ..Options::default()
+        };
+        let mut db = Db::create(&d, o).unwrap();
+        db.watch_dir_syncs();
+        db.fail_next_run_dir_sync();
+        let first = rd_batch(&mut db, 0, 100);
+        let r = match tag {
+            "always" => first,
+            "everyn" => {
+                first.unwrap_or_else(|e| panic!("{tag}: the commit not due: {e}"));
+                rd_batch(&mut db, 100, 100)
+            }
+            _ => {
+                first.unwrap_or_else(|e| panic!("{tag}: the commit: {e}"));
+                db.sync()
+            }
+        };
+        let words = "a test failed this run's directory fsync";
+        match r {
+            Ok(()) => panic!("{tag}: answered Ok over the run's failed barrier"),
+            Err(e) => assert!(
+                e.to_string().contains(words),
+                "{tag}: answered with another error: {e}"
+            ),
+        }
+        assert!(rd_barriers(&db) >= 1, "{tag}: the barrier was asked");
+        for (what, r) in [
+            ("a commit of nothing", db.commit()),
+            ("a sync", db.sync()),
+            ("a later batch", rd_batch(&mut db, 1000, 10)),
+        ] {
+            match r {
+                Ok(()) => panic!("{tag}: {what} answered Ok after the failed barrier"),
+                Err(e) => assert!(
+                    e.to_string().contains(words),
+                    "{tag}: {what} answered with another error: {e}"
+                ),
+            }
+        }
+        drop(db);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
+
+/// Under a cipher nothing of a run is in the directory until its
+/// envelope, and its commits are frames of the log, synced there: no run
+/// barrier is made, under either policy, and the run reads back.
+#[test]
+fn a_run_under_a_cipher_makes_no_directory_barrier() {
+    for (tag, policy) in [
+        ("always", SyncPolicy::Always),
+        ("sync", SyncPolicy::EveryN(u32::MAX)),
+    ] {
+        let d = dir(&format!("dur-rd-cipher-{tag}"));
+        let o = Options {
+            sync: policy,
+            ..under_cipher()
+        };
+        let mut db = Db::create(&d, o).unwrap();
+        db.watch_dir_syncs();
+        for c in 0..10 {
+            rd_batch(&mut db, c * 100, 100).unwrap();
+        }
+        db.sync().unwrap();
+        assert_eq!(db.levels(), (0, 0), "{tag}: the run is open");
+        assert_eq!(rd_barriers(&db), 0, "{tag}: a barrier under a cipher");
+        reads(&db, &key(942), "v", tag);
+        drop(db);
+        let _ = std::fs::remove_dir_all(&d);
+    }
+}
+
+/// A run closed by a `flush` before any sync covered it owes its name to
+/// nothing the writer makes: the flush is answered behind the landing's
+/// directory fsync, made while the run's segment was linked under its
+/// piece's name.
+#[test]
+fn a_flush_of_a_run_no_sync_covered_is_answered_behind_a_directory_fsync_of_its_segment() {
+    let d = dir("dur-rd-flush");
+    let o = Options {
+        sync: SyncPolicy::EveryN(u32::MAX),
+        ..Options::default()
+    };
+    let mut db = Db::create(&d, o).unwrap();
+    db.watch_dir_syncs();
+    rd_batch(&mut db, 0, 100).unwrap();
+    assert_eq!(rd_tmps(&d).len(), 1, "the batch opened a run");
+    db.flush().unwrap();
+    let segs = seg_names(&d);
+    assert!(!segs.is_empty(), "the flush landed the run");
+    for s in &segs {
+        assert!(
+            rd_covered(&db, s),
+            "the flush answered with no directory fsync since {s} was linked"
+        );
+    }
+    drop(db);
+    let _ = std::fs::remove_dir_all(&d);
+}
