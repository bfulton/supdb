+// ---------------------------------------------------------------------
+// run-close: a run that closes under `EveryN` with commits no sync has
+// covered goes to its seal with what its writer held written, so a later
+// commit to the log is never on the file ahead of the run's; and the next
+// sync of any kind -- `Db::sync`, the log's due sync at a commit, a later
+// run's due sync -- covers the closed run's file before anything newer,
+// or answers why it cannot.
+// ---------------------------------------------------------------------
+
+/// How a run is closed: by a write the run cannot take -- an append of a
+/// key below its greatest, a delete or a put of a key above it, an append
+/// above it of a value that does not inline -- each committed to the log,
+/// or by a seal, `Db::seal`'s or the one the run's own commit makes at
+/// the seal threshold.
+#[derive(Clone, Copy, Debug)]
+enum RunClosed {
+    LowerKey,
+    DeleteAbove,
+    PutAbove,
+    NotInline,
+    Seal,
+    CommitSeal,
+}
+
+const RUN_CLOSED: [RunClosed; 6] = [
+    RunClosed::LowerKey,
+    RunClosed::DeleteAbove,
+    RunClosed::PutAbove,
+    RunClosed::NotInline,
+    RunClosed::Seal,
+    RunClosed::CommitSeal,
+];
+
+/// The run's arms: the stream the table writes from, and the copies.
+fn rc_arms() -> [(&'static str, Options); 2] {
+    [
+        ("default", Options::default()),
+        (
+            "copyvals",
+            Options {
+                direct_stream: false,
+                ..Options::default()
+            },
+        ),
+    ]
+}
+
+/// `n` keys of a run in commits of `per`, under `sync`, the run's last
+/// commit crossing the seal threshold where `closed` is the commit's seal;
+/// the store, the keys the run's commits before the close wrote, and the
+/// options.
+fn rc_store(d: &Path, sync: SyncPolicy, arm: Options, closed: RunClosed, n: u32, per: u32) -> (Db, u32, Options) {
+    let mut opts = sr_opts(sync, arm);
+    if matches!(closed, RunClosed::CommitSeal) {
+        // A key and its value are 110 bytes of the table: the last commit
+        // crosses the threshold, the one before not.
+        opts.seal_bytes = (n - per / 2) as usize * 110;
+    }
+    let db = Db::create(d, opts.clone()).unwrap();
+    let first = if matches!(closed, RunClosed::CommitSeal) {
+        n - per
+    } else {
+        n
+    };
+    (db, first, opts)
+}
+
+/// The run closed as `closed` says, the run's keys `first..n` written by
+/// the commit that crosses the threshold where that is the close; the
+/// closing write's key and value where it has one.
+fn rc_close(db: &mut Db, closed: RunClosed, first: u32, n: u32, per: u32) -> Option<(Vec<u8>, Vec<Vec<u8>>)> {
+    let above = sr_key(n + 10_000);
+    match closed {
+        RunClosed::LowerKey => {
+            db.append(b"a-lower", b"below the run");
+            db.commit().unwrap();
+            Some((b"a-lower".to_vec(), vec![b"below the run".to_vec()]))
+        }
+        RunClosed::DeleteAbove => {
+            db.delete(&above);
+            db.commit().unwrap();
+            None
+        }
+        RunClosed::PutAbove => {
+            db.put(&above, b"put above the run");
+            db.commit().unwrap();
+            Some((above, vec![b"put above the run".to_vec()]))
+        }
+        RunClosed::NotInline => {
+            let big = vec![b'w'; 1000];
+            db.append(&above, &big);
+            db.commit().unwrap();
+            Some((above, vec![big]))
+        }
+        RunClosed::Seal => {
+            db.seal().unwrap();
+            None
+        }
+        RunClosed::CommitSeal => {
+            sr_commits(db, first, n, per);
+            None
+        }
+    }
+}
