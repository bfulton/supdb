+/// Under `EveryN(u32::MAX)` a run closes into a seal held before it
+/// writes anything, and a commit to the log follows; a process kill then
+/// keeps the page cache. A store that reads the later commit back reads
+/// every commit of the run before it: the run's held tail is on its file
+/// before the close hands it on, not left to the seal's finish.
+#[test]
+fn a_later_commit_survives_a_kill_only_with_the_closed_run_before_it() {
+    let mut failures = Vec::new();
+    for (arm, base) in rc_arms() {
+        for closed in RUN_CLOSED {
+            for (held, n, per) in [("small", 300u32, 100u32), ("large", 12_000, 1000)] {
+                let tag = format!("{arm}-{closed:?}-{held}");
+                let d = dir(&format!("dur-rckill-{tag}"));
+                let kill = dir(&format!("dur-rckill-{tag}-kill"));
+                let (mut db, first, opts) =
+                    rc_store(&d, SyncPolicy::EveryN(u32::MAX), base.clone(), closed, n, per);
+                sr_commits(&mut db, 0, first, per);
+                rc_held(&mut db, |db| {
+                    rc_close(db, closed, first, n, per);
+                    assert!(db.run_synced_bytes().is_none(), "{tag}: the run closed");
+                    assert!(db.in_flight().0, "{tag}: its seal is held in flight");
+                    let (_, _, before) = db.wal_durable();
+                    db.append(b"a-later", b"after the run");
+                    db.commit().unwrap();
+                    assert!(db.wal_durable().2 > before, "{tag}: the later commit is in the log");
+                    copy_store(&d, &kill);
+                });
+                drop(db);
+                let opened = Db::open(&kill, opts.clone()).unwrap();
+                if read_vec(&opened, b"a-later") == vec![b"after the run".to_vec()] {
+                    failures.extend(sr_missing(
+                        &opened,
+                        n,
+                        &format!("{tag}: killed with the later commit read back"),
+                    ));
+                } else {
+                    failures.push(format!("{tag}: the later commit, in the page cache, lost to a kill"));
+                }
+                drop(opened);
+                for p in [&d, &kill] {
+                    let _ = std::fs::remove_dir_all(p);
+                }
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+/// Under `EveryN(u32::MAX)` a run's commits are left unsynced, and the
+/// run closes into a seal held before it writes anything (its finish
+/// after the landing hold). A `sync` answered `Ok` after the close:
+/// killed then, and cut by a power cut to what the fdatasyncs covered,
+/// every commit before the sync reads back -- the run's as well as the
+/// closing write's in the log.
+#[test]
+fn a_sync_after_a_run_closed_into_a_seal_in_flight_makes_the_runs_commits_durable() {
+    let mut failures = Vec::new();
+    for (arm, base) in rc_arms() {
+        for closed in RUN_CLOSED {
+            for (held, n, per) in [("small", 300u32, 100u32), ("large", 12_000, 1000)] {
+                let tag = format!("{arm}-{closed:?}-{held}");
+                let d = dir(&format!("dur-rcsync-{tag}"));
+                let kill = dir(&format!("dur-rcsync-{tag}-kill"));
+                let cut = dir(&format!("dur-rcsync-{tag}-cut"));
+                let (mut db, first, opts) =
+                    rc_store(&d, SyncPolicy::EveryN(u32::MAX), base.clone(), closed, n, per);
+                sr_commits(&mut db, 0, first, per);
+                let synced = db.run_synced_bytes().expect("the run is open");
+                let ino = run_ino(&d);
+                let want = rc_held(&mut db, |db| {
+                    let want = rc_close(db, closed, first, n, per);
+                    assert!(db.run_synced_bytes().is_none(), "{tag}: the run closed");
+                    assert!(db.in_flight().0, "{tag}: its seal is held in flight");
+                    let from = Db::trace_dir_io(true).len();
+                    db.sync().unwrap();
+                    copy_store(&d, &kill);
+                    rc_power_cut(db, &d, &cut, &[(ino, synced)], from);
+                    want
+                });
+                drop(db);
+                for (how, c) in [("killed", &kill), ("a power cut", &cut)] {
+                    let opened = Db::open(c, opts.clone()).unwrap();
+                    failures.extend(sr_missing(
+                        &opened,
+                        n,
+                        &format!("{tag}: {how} after an Ok sync"),
+                    ));
+                    if let Some((k, v)) = &want {
+                        if &read_vec(&opened, k) != v {
+                            failures.push(format!("{tag}: {how}: the closing write's commit lost"));
+                        }
+                    }
+                    drop(opened);
+                }
+                for p in [&d, &kill, &cut] {
+                    let _ = std::fs::remove_dir_all(p);
+                }
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+/// Under `EveryN(4)` a run of two commits closes into a held seal, and the
+/// policy's next due sync is the fourth commit's: the log's, where later
+/// writes go to the log, or a later run's own, where a seal left the table
+/// empty and a key above the store's greatest opened another run. Cut by
+/// a power cut after it, a store that reads that commit back reads every
+/// commit of the closed run before it.
+#[test]
+fn the_policys_due_sync_after_a_run_closed_covers_the_closed_run_first() {
+    let mut failures = Vec::new();
+    for (arm, base) in rc_arms() {
+        for closed in RUN_CLOSED {
+            for next in ["log", "run"] {
+                if next == "run" && !matches!(closed, RunClosed::Seal | RunClosed::CommitSeal) {
+                    // A write to the log leaves a table a run cannot open over.
+                    continue;
+                }
+                let tag = format!("{arm}-{closed:?}-{next}");
+                let d = dir(&format!("dur-rcdue-{tag}"));
+                let cut = dir(&format!("dur-rcdue-{tag}-cut"));
+                let (mut db, first, opts) =
+                    rc_store(&d, SyncPolicy::EveryN(4), base.clone(), closed, 200, 100);
+                sr_commits(&mut db, 0, first, 100);
+                let synced = db.run_synced_bytes().expect("the run is open");
+                let ino = run_ino(&d);
+                let newer = rc_held(&mut db, |db| {
+                    let from = Db::trace_dir_io(true).len();
+                    let (_, log_synced, _) = db.wal_durable();
+                    rc_close(db, closed, first, 200, 100);
+                    assert!(db.run_synced_bytes().is_none(), "{tag}: the run closed");
+                    assert!(db.in_flight().0, "{tag}: its seal is held in flight");
+                    assert_eq!(db.wal_durable().1, log_synced, "{tag}: the close is not the due sync");
+                    let mut runs = vec![(ino, synced)];
+                    let newer: Vec<u8> = if next == "log" {
+                        let mut k = 0;
+                        while db.wal_durable().1 == log_synced {
+                            assert!(k < 4, "{tag}: the policy's sync came");
+                            db.append(format!("a-later-{k}").as_bytes(), b"after the run");
+                            db.commit().unwrap();
+                            k += 1;
+                        }
+                        format!("a-later-{}", k - 1).into_bytes()
+                    } else {
+                        let mut k = 30_000;
+                        loop {
+                            assert!(k < 30_004, "{tag}: the policy's sync came");
+                            db.append(&sr_key(k), &sr_val(k));
+                            db.commit().unwrap();
+                            k += 1;
+                            if db.run_synced_bytes().expect("a second run is open") > 0 {
+                                break;
+                            }
+                        }
+                        runs.push((run_ino_newest(&d), db.run_synced_bytes().unwrap()));
+                        sr_key(k - 1)
+                    };
+                    rc_power_cut(db, &d, &cut, &runs, from);
+                    newer
+                });
+                drop(db);
+                let opened = Db::open(&cut, opts.clone()).unwrap();
+                if read_vec(&opened, &newer).is_empty() {
+                    failures.push(format!("{tag}: the due commit lost to the cut"));
+                } else {
+                    failures.extend(sr_missing(
+                        &opened,
+                        200,
+                        &format!("{tag}: a power cut after the due sync, its commit read back"),
+                    ));
+                }
+                drop(opened);
+                for p in [&d, &cut] {
+                    let _ = std::fs::remove_dir_all(p);
+                }
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+/// The newest run temp file in `d`: the open one, after an earlier run's
+/// temp name stayed for its seal.
+fn run_ino_newest(d: &Path) -> u64 {
+    use std::os::unix::fs::MetadataExt;
+    let mut names: Vec<std::ffi::OsString> = std::fs::read_dir(d)
+        .unwrap()
+        .map(|e| e.unwrap().file_name())
+        .filter(|n| {
+            let n = n.to_string_lossy();
+            n.starts_with("direct-") && n.ends_with(".tmp")
+        })
+        .collect();
+    names.sort();
+    std::fs::metadata(d.join(names.last().expect("a run's temp file")))
+        .unwrap()
+        .ino()
+}
+
+/// A run closed under `EveryN(u32::MAX)` into a seal that then fails to
+/// make its segment durable: the queue stops, the seal is never tried
+/// again, and its segment is named by no manifest. A `sync` after that
+/// either makes the run's commits durable -- the temp name stays, and an
+/// open recovers them from it -- or answers the failure: answered `Ok`,
+/// killed and cut by a power cut, every commit before it reads back.
+#[test]
+fn a_sync_over_a_closed_run_whose_seal_failed_makes_it_durable_or_answers() {
+    let mut failures = Vec::new();
+    for (arm, base) in rc_arms() {
+        for closed in [RunClosed::LowerKey, RunClosed::Seal] {
+            let tag = format!("{arm}-{closed:?}");
+            let d = dir(&format!("dur-rcfailed-{tag}"));
+            let kill = dir(&format!("dur-rcfailed-{tag}-kill"));
+            let cut = dir(&format!("dur-rcfailed-{tag}-cut"));
+            let (mut db, first, opts) =
+                rc_store(&d, SyncPolicy::EveryN(u32::MAX), base.clone(), closed, 300, 100);
+            sr_commits(&mut db, 0, first, 100);
+            let synced = db.run_synced_bytes().expect("the run is open");
+            let ino = run_ino(&d);
+            db.fail_next_seal_sync();
+            // Held across the close, so the closing commit is answered
+            // before the seal can fail.
+            rc_held(&mut db, |db| {
+                rc_close(db, closed, first, 300, 100);
+            });
+            let t = std::time::Instant::now();
+            while !db.seals_wedged() {
+                assert!(t.elapsed().as_secs() < 60, "{tag}: the seal's failure stopped the queue");
+                std::thread::sleep(std::time::Duration::from_millis(2));
+            }
+            let answered = rc_held(&mut db, |db| {
+                let from = Db::trace_dir_io(true).len();
+                let r = db.sync();
+                copy_store(&d, &kill);
+                rc_power_cut(db, &d, &cut, &[(ino, synced)], from);
+                r
+            });
+            drop(db);
+            match answered {
+                Err(e) => {
+                    let s = e.to_string();
+                    if !s.contains("a test failed this seal's fsync") && !s.contains("seal") {
+                        failures.push(format!("{tag}: answered an error that is not the seal's: {s}"));
+                    }
+                }
+                Ok(()) => {
+                    for (how, c) in [("killed", &kill), ("a power cut", &cut)] {
+                        let opened = Db::open(c, opts.clone()).unwrap();
+                        failures.extend(sr_missing(
+                            &opened,
+                            300,
+                            &format!("{tag}: {how} after an Ok sync over the stopped queue"),
+                        ));
+                        drop(opened);
+                    }
+                }
+            }
+            for p in [&d, &kill, &cut] {
+                let _ = std::fs::remove_dir_all(p);
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+/// The fdatasync a sync makes of a closed run's file fails: the sync
+/// answers it, the store keeps it -- every commit and sync after answers
+/// it until the store is reopened -- and the seal queue stops, so no
+/// manifest names the run's segment durable over the device's word, under
+/// both shapes of the next sync: `Db::sync`, and the log's due sync.
+#[test]
+fn a_failed_sync_of_a_closed_runs_file_is_answered_and_kept() {
+    for (arm, base) in rc_arms() {
+        for via in ["sync", "due"] {
+            let tag = format!("{arm}-{via}");
+            let d = dir(&format!("dur-rcsyncfail-{tag}"));
+            let sync = if via == "sync" {
+                SyncPolicy::EveryN(u32::MAX)
+            } else {
+                SyncPolicy::EveryN(3)
+            };
+            let (mut db, first, _) = rc_store(&d, sync, base.clone(), RunClosed::Seal, 200, 100);
+            sr_commits(&mut db, 0, first, 100);
+            rc_held(&mut db, |db| {
+                rc_close(db, RunClosed::Seal, first, 200, 100);
+                db.fail_next_closed_run_sync();
+                let r = if via == "sync" {
+                    db.sync()
+                } else {
+                    db.append(b"a-later", b"after the run");
+                    db.commit()
+                };
+                injected(r, &format!("{tag}: the sync over the closed run"));
+                db.append(b"a-later-2", b"after the failure");
+                injected(db.commit(), &format!("{tag}: the commit after"));
+                injected(db.sync(), &format!("{tag}: the sync after"));
+                assert!(db.seals_wedged(), "{tag}: the seal queue stopped");
+            });
+            drop(db);
+            let _ = std::fs::remove_dir_all(&d);
+        }
+    }
+}
+
+/// Under `Always` every commit of a run is synced before it is answered,
+/// so a run closes owing nothing: no sync after the close fdatasyncs the
+/// closed run's file (`Db::trace_dir_io`), and the store reads back.
+#[test]
+fn a_run_closed_under_always_leaves_no_sync_owed() {
+    for (arm, base) in rc_arms() {
+        for closed in RUN_CLOSED {
+            let tag = format!("{arm}-{closed:?}");
+            let d = dir(&format!("dur-rcalways-{tag}"));
+            let (mut db, first, _) = rc_store(&d, SyncPolicy::Always, base.clone(), closed, 300, 100);
+            sr_commits(&mut db, 0, first, 100);
+            rc_held(&mut db, |db| {
+                rc_close(db, closed, first, 300, 100);
+                let from = Db::trace_dir_io(true).len();
+                db.append(b"a-later", b"after the run");
+                db.commit().unwrap();
+                db.sync().unwrap();
+                let synced: Vec<_> = Db::trace_dir_io(true)[from..]
+                    .iter()
+                    .filter(|(what, p)| *what == "sync_run" && p.starts_with(&d))
+                    .cloned()
+                    .collect();
+                assert!(synced.is_empty(), "{tag}: a closed run synced under Always: {synced:?}");
+            });
+            drop(db);
+            let _ = std::fs::remove_dir_all(&d);
+        }
+    }
+}
+
+/// How the sync after a closed run is reached in
+/// `a_power_cut_after_a_closed_runs_failed_sync_keeps_the_order`: a
+/// `sync` with nothing staged, the policy's due commit, a `sync` whose own
+/// commit of what is staged is due, a `Db::seal` whose commit is due, the
+/// same with seals that rotate the log (`Options::seal_rotates_wal`).
+#[derive(Clone, Copy, Debug)]
+enum ClosedSyncVia {
+    Sync,
+    DueCommit,
+    StagedSync,
+    Seal,
+    RotatingSeal,
+}
+
+/// A run of two commits closes into a held seal by a key below its
+/// greatest, committed to the log; the sync after it fails at the closed
+/// run's fdatasync (`Db::fail_next_closed_run_sync`), and the call that
+/// made it answers the failure. Cut by a power cut there, whatever of the
+/// log a sync covered is newer than the run: a store that reads a commit
+/// of the log back reads every commit of the run before it, so the closed
+/// run's file is synced before the log, on every path to the log's sync.
+#[test]
+fn a_power_cut_after_a_closed_runs_failed_sync_keeps_the_order() {
+    let mut failures = Vec::new();
+    for (arm, base) in rc_arms() {
+        for via in [
+            ClosedSyncVia::Sync,
+            ClosedSyncVia::DueCommit,
+            ClosedSyncVia::StagedSync,
+            ClosedSyncVia::Seal,
+            ClosedSyncVia::RotatingSeal,
+        ] {
+            let tag = format!("{arm}-{via:?}");
+            let d = dir(&format!("dur-rcorder-{tag}"));
+            let cut = dir(&format!("dur-rcorder-{tag}-cut"));
+            let sync = if matches!(via, ClosedSyncVia::Sync) {
+                SyncPolicy::EveryN(u32::MAX)
+            } else {
+                SyncPolicy::EveryN(4)
+            };
+            let mut arm_opts = base.clone();
+            arm_opts.seal_rotates_wal = matches!(via, ClosedSyncVia::RotatingSeal);
+            let (mut db, first, opts) = rc_store(&d, sync, arm_opts, RunClosed::LowerKey, 200, 100);
+            sr_commits(&mut db, 0, first, 100);
+            let synced = db.run_synced_bytes().expect("the run is open");
+            let ino = run_ino(&d);
+            rc_held(&mut db, |db| {
+                let from = Db::trace_dir_io(true).len();
+                rc_close(db, RunClosed::LowerKey, first, 200, 100);
+                assert!(db.in_flight().0, "{tag}: the run's seal is held in flight");
+                db.fail_next_closed_run_sync();
+                let r = match via {
+                    ClosedSyncVia::Sync => db.sync(),
+                    ClosedSyncVia::DueCommit => {
+                        db.append(b"a-later", b"after the run");
+                        db.commit()
+                    }
+                    ClosedSyncVia::StagedSync => {
+                        db.append(b"a-later", b"after the run");
+                        db.sync()
+                    }
+                    ClosedSyncVia::Seal | ClosedSyncVia::RotatingSeal => {
+                        db.append(b"a-later", b"after the run");
+                        db.seal()
+                    }
+                };
+                injected(r, &format!("{tag}: the sync over the closed run"));
+                rc_power_cut(db, &d, &cut, &[(ino, synced)], from);
+            });
+            drop(db);
+            let opened = Db::open(&cut, opts.clone()).unwrap();
+            let newer = read_vec(&opened, b"a-lower").len() + read_vec(&opened, b"a-later").len();
+            if newer > 0 {
+                failures.extend(sr_missing(
+                    &opened,
+                    200,
+                    &format!("{tag}: a power cut kept a commit of the log after the closed run"),
+                ));
+            }
+            drop(opened);
+            for p in [&d, &cut] {
+                let _ = std::fs::remove_dir_all(p);
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+/// A run closes under `EveryN(u32::MAX)` with its next write of the file
+/// failed (`Db::fail_next_run_write`), so the close cannot write what its
+/// writer holds: a `sync` while its seal is held answers that the run is
+/// durable only once the seal lands, and once the seal has landed
+/// (`settle`) a `sync` answers `Ok`, and a power cut and a kill read
+/// every commit back.
+#[test]
+fn a_sync_over_a_run_whose_close_could_not_write_answers_until_its_seal_lands() {
+    for (arm, base) in rc_arms() {
+        let tag = arm.to_string();
+        let d = dir(&format!("dur-rcunwritten-{tag}"));
+        let cut = dir(&format!("dur-rcunwritten-{tag}-cut"));
+        let (mut db, first, opts) =
+            rc_store(&d, SyncPolicy::EveryN(u32::MAX), base.clone(), RunClosed::Seal, 300, 100);
+        sr_commits(&mut db, 0, first, 100);
+        rc_held(&mut db, |db| {
+            db.fail_next_run_write();
+            rc_close(db, RunClosed::Seal, first, 300, 100);
+            match db.sync() {
+                Ok(()) => panic!("{tag}: a sync answered Ok over a closed run its close could not write"),
+                Err(e) => assert!(
+                    e.to_string().contains("durable only once its seal lands"),
+                    "{tag}: the sync's words: {e}"
+                ),
+            }
+        });
+        db.settle().unwrap();
+        db.sync().unwrap();
+        let (log, log_synced, _) = db.wal_durable();
+        copy_store(&d, &cut);
+        if let Some(name) = log.file_name() {
+            if let Ok(f) = std::fs::OpenOptions::new()
+                .write(true)
+                .open(cut.join(name))
+            {
+                f.set_len(log_synced).unwrap();
+            }
+        }
+        drop(db);
+        for (how, c) in [("a power cut", &cut), ("killed", &d)] {
+            let opened = Db::open(c, opts.clone()).unwrap();
+            if let Some(m) = sr_missing(&opened, 300, &format!("{tag}: {how} after the landing")) {
+                panic!("{m}");
+            }
+            drop(opened);
+        }
+        for p in [&d, &cut] {
+            let _ = std::fs::remove_dir_all(p);
+        }
+    }
+}
