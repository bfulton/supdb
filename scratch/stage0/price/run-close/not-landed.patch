+/// A power cut of a store whose closed runs' seals are held: its files
+/// copied from `d` to `crash`, each run's file (by its inode, every name
+/// it has) cut to what its writer's fdatasyncs covered before the close
+/// unless a sync of a closed run's file returned for it since the trace's
+/// `from` (`Db::trace_dir_io`, the record made by the call), in which case
+/// it is kept whole -- nothing writes a closed run's file while its seal
+/// is held -- and the log cut to its synced length.
+fn rc_power_cut(db: &Db, d: &Path, crash: &Path, runs: &[(u64, u64)], from: usize) {
+    use std::os::unix::fs::MetadataExt;
+    let synced_since: Vec<u64> = Db::trace_dir_io(true)[from..]
+        .iter()
+        .filter(|(what, p)| *what == "sync_run" && p.starts_with(d))
+        .filter_map(|(_, p)| std::fs::metadata(p).ok().map(|m| m.ino()))
+        .collect();
+    let (log, log_synced, _) = db.wal_durable();
+    copy_store(d, crash);
+    for e in std::fs::read_dir(d).unwrap() {
+        let e = e.unwrap();
+        let Some(ino) = e.metadata().map(|m| m.ino()).ok() else {
+            continue;
+        };
+        if let Some(&(_, synced)) = runs.iter().find(|(i, _)| *i == ino) {
+            if synced_since.contains(&ino) {
+                continue;
+            }
+            if let Ok(f) = std::fs::OpenOptions::new()
+                .write(true)
+                .open(crash.join(e.file_name()))
+            {
+                f.set_len(synced).unwrap();
+            }
+        }
+    }
+    if let Some(name) = log.file_name() {
+        if let Ok(f) = std::fs::OpenOptions::new()
+            .write(true)
+            .open(crash.join(name))
+        {
+            f.set_len(log_synced).unwrap();
+        }
+    }
+}
+
+/// Every landing held across `f`, and let go after it, so that a copy of
+/// the live store in `f` is a crash: nothing lands inside it.
+fn rc_held<T>(db: &mut Db, f: impl FnOnce(&mut Db) -> T) -> T {
+    db.hold_seal_landing(true);
+    db.hold_merge_landing(true);
+    let caught = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(&mut *db)));
+    db.hold_seal_landing(false);
+    db.hold_merge_landing(false);
+    match caught {
+        Ok(t) => t,
+        Err(p) => std::panic::resume_unwind(p),
+    }
+}
