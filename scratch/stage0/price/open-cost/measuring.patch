new file mode 100644
index 00000000..cbb845fa
--- /dev/null
+++ b/bench/examples/open_cost.rs
@@ -0,0 +1,233 @@
+//! Pricing the open-cost unit (measuring only): what `Db::open` costs a
+//! store of the suite's shape, the open as it is (`folded`) against the
+//! open as stage 0 landed it (`Options::price_open_cost_old`, `landed`) and
+//! the open with no slot synced and no named segment looked for
+//! (`Options::price_open_cost_bare`, `bare`), alternating over the same
+//! store's files in one process.
+//!
+//!     open_cost <supdb|supdb-ingest> <size> <opens> <clean|log|unnamed> [variant]
+//!
+//! `clean`: the store loaded through the suite's adapter, settled and
+//! closed. `log`: then a hundredth of its keys rewritten in commits no flush
+//! covered and the store copied under holds of every landing, so each open
+//! replays a log. `unnamed`: then a hundredth rewritten and flushed with the
+//! merges held at their landing and the store copied there, so each open
+//! finds the merges' outputs unnamed beside the slot. With a `variant`, only
+//! that variant is opened, between two lines on stderr (`OPENCOST-MARK`,
+//! `OPENCOST-END`) for a syscall trace to be cut at.
+use std::path::Path;
+use std::time::Instant;
+use supdb_bench::engines::{Batch, Engine, Supdb};
+use supdb_bench::workload::{db_key_into, Payload, Rng};
+
+fn copy_dir(from: &Path, to: &Path) {
+    let _ = std::fs::remove_dir_all(to);
+    std::fs::create_dir_all(to).unwrap();
+    for e in std::fs::read_dir(from).unwrap() {
+        let e = e.unwrap();
+        if e.file_type().unwrap().is_file() {
+            // Each copy synced, so the open after it finds the crash state
+            // on the device and not a page cache of dirty copies, which its
+            // first fdatasync would pay the journal's writeback of.
+            match std::fs::copy(e.path(), to.join(e.file_name())) {
+                Ok(_) => std::fs::File::open(to.join(e.file_name()))
+                    .and_then(|f| f.sync_all())
+                    .unwrap(),
+                Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+                Err(err) => panic!("copy {:?}: {err}", e.path()),
+            }
+        }
+    }
+}
+
+fn listing(d: &Path) -> Vec<(String, u64)> {
+    let mut v: Vec<(String, u64)> = std::fs::read_dir(d)
+        .unwrap()
+        .map(|e| {
+            let e = e.unwrap();
+            (
+                e.file_name().to_string_lossy().into_owned(),
+                e.metadata().unwrap().len(),
+            )
+        })
+        .collect();
+    v.sort();
+    v
+}
+
+fn rewrite(e: &mut Supdb, size: u64, payload: &Payload, vrng: &mut Rng) {
+    let mut kb = [0u8; 16];
+    let mut buf = Batch::with_capacity(1000, payload.value_size());
+    for i in (0..size).step_by(100) {
+        db_key_into(i, &mut kb);
+        buf.push(&kb, payload.get(vrng));
+        if buf.len() == 1000 {
+            buf.flush(e).unwrap();
+        }
+    }
+    if !buf.is_empty() {
+        buf.flush(e).unwrap();
+    }
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let arm = args.get(1).cloned().unwrap_or("supdb".into());
+    let size: u64 = args.get(2).and_then(|s| s.parse().ok()).unwrap_or(10_000);
+    let opens: usize = args.get(3).and_then(|s| s.parse().ok()).unwrap_or(200);
+    let mode = args.get(4).cloned().unwrap_or("clean".into());
+    let only = args.get(5).cloned();
+    let payload = Payload::new(100, 0.5, 0xE1);
+    let root = std::env::temp_dir().join(format!("supdb-opencost-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&root);
+    let dir = root.join("store");
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut e = match arm.as_str() {
+        "supdb" => Supdb::create(&dir).unwrap(),
+        "supdb-ingest" => Supdb::create_ingest(&dir).unwrap(),
+        a => panic!("no arm {a}"),
+    };
+    let base = e.reopen_options();
+    let mut vrng = Rng::new(0xE1);
+    let mut kb = [0u8; 16];
+    let mut buf = Batch::with_capacity(1000, payload.value_size());
+    for i in 0..size {
+        db_key_into(i, &mut kb);
+        buf.push(&kb, payload.get(&mut vrng));
+        if buf.len() == 1000 {
+            buf.flush(&mut e).unwrap();
+        }
+    }
+    if !buf.is_empty() {
+        buf.flush(&mut e).unwrap();
+    }
+    e.sync().unwrap();
+    e.settle().unwrap();
+    let target = match mode.as_str() {
+        "clean" => {
+            e.close_store().unwrap();
+            dir.clone()
+        }
+        "log" => {
+            rewrite(&mut e, size, &payload, &mut vrng);
+            let db = e.store();
+            db.hold_seal_landing(true);
+            db.hold_merge_landing(true);
+            let c = root.join("crash");
+            copy_dir(&dir, &c);
+            let db = e.store();
+            db.hold_seal_landing(false);
+            db.hold_merge_landing(false);
+            drop(e);
+            c
+        }
+        "unnamed" => {
+            // Opened again with a flush that does not partition, which
+            // answers before the merge it hands over lands.
+            e.close_store().unwrap();
+            let mut db = supdb::Db::open(
+                &dir,
+                supdb::Options {
+                    partition_on_flush: false,
+                    ..base.clone()
+                },
+            )
+            .unwrap();
+            for i in (0..size).step_by(100) {
+                db_key_into(i, &mut kb);
+                db.put(&kb, payload.get(&mut vrng));
+            }
+            db.commit().unwrap();
+            db.hold_merge_landing(true);
+            db.flush().unwrap();
+            let t = Instant::now();
+            while !db.merge_waits_at_landing() && t.elapsed().as_secs() < 120 {
+                std::thread::sleep(std::time::Duration::from_millis(1));
+            }
+            eprintln!("merge held at its landing: {}", db.merge_waits_at_landing());
+            db.hold_seal_landing(true);
+            let c = root.join("crash");
+            copy_dir(&dir, &c);
+            db.hold_seal_landing(false);
+            db.hold_merge_landing(false);
+            drop(db);
+            c
+        }
+        m => panic!("no mode {m}"),
+    };
+    let variants: Vec<(&str, supdb::Options)> = vec![
+        ("folded", base.clone()),
+        (
+            "landed",
+            supdb::Options {
+                price_open_cost_old: true,
+                ..base.clone()
+            },
+        ),
+        (
+            "bare",
+            supdb::Options {
+                price_open_cost_bare: true,
+                ..base.clone()
+            },
+        ),
+    ];
+    // Each open of an unnamed state is of a fresh copy of it.
+    let (target, master) = if mode == "unnamed" {
+        (root.join("master"), target)
+    } else {
+        (target.clone(), target)
+    };
+    if mode == "unnamed" {
+        copy_dir(&master, &target);
+    }
+    let before = listing(&target);
+    let segs = before.iter().filter(|(n, _)| n.ends_with(".sup")).count();
+    if let Some(v) = only {
+        let opts = variants.iter().find(|(n, _)| *n == v).unwrap().1.clone();
+        for _ in 0..opens {
+            eprintln!("OPENCOST-MARK");
+            let db = supdb::Db::open(&target, opts.clone()).unwrap();
+            eprintln!("OPENCOST-END");
+            drop(db);
+        }
+        let _ = std::fs::remove_dir_all(&root);
+        return;
+    }
+    let mut times: Vec<Vec<f64>> = vec![Vec::new(); variants.len()];
+    for r in 0..opens {
+        for j in 0..variants.len() {
+            let k = (r + j) % variants.len();
+            // An open sweeps what the slot does not name: the crash state
+            // put back before each open that has one to read.
+            if mode == "unnamed" {
+                copy_dir(&master, &target);
+            }
+            let t = Instant::now();
+            let db = supdb::Db::open(&target, variants[k].1.clone()).unwrap();
+            times[k].push(t.elapsed().as_secs_f64() * 1e6);
+            drop(db);
+        }
+    }
+    let after = listing(&target);
+    println!(
+        "{arm} size {size} mode {mode}: {} files, {segs} segments; files unchanged by the opens: {}",
+        before.len(),
+        before == after
+    );
+    for (k, (n, _)) in variants.iter().enumerate() {
+        let first = times[k][0];
+        let mut rest = times[k][1..].to_vec();
+        rest.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        let q = |p: f64| rest[((rest.len() - 1) as f64 * p) as usize];
+        println!(
+            "  {n:7} first {first:9.1} us  median {:9.1}  p10 {:9.1}  p90 {:9.1}  mean {:9.1}  (n {})",
+            q(0.5),
+            q(0.1),
+            q(0.9),
+            rest.iter().sum::<f64>() / rest.len() as f64,
+            rest.len()
+        );
+    }
+    let _ = std::fs::remove_dir_all(&root);
+}
